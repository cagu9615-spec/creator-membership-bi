-- 1. Staging Stripe
CREATE OR REPLACE TABLE `creator_staging.stg_stripe` AS
WITH deduplicated AS (
  SELECT
    *,
    ROW_NUMBER() OVER (
      ORDER BY SAFE_CAST(ingested_at AS TIMESTAMP) DESC
    ) AS rn
  FROM `creator_raw.raw_stripe`
)
SELECT * EXCEPT(rn)
FROM deduplicated
WHERE rn = 1;

